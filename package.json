{
  "name": "coppice-monorepo",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:website": "turbo build --filter=website",
    "build:desktop": "turbo build --filter=desktop",
    "dmg": "turbo dmg --filter=desktop",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  }
}
